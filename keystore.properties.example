# Copy to keystore.properties (git-ignored) and fill in. Environment variables with the
# FRAME_ prefix (see app/build.gradle.kts) work too and take effect when a key is missing here.
storeFile=release.jks
storePassword=
keyAlias=frame
keyPassword=

# Real AdMob IDs from https://apps.admob.com. Without them release builds use Google's test ads.
admobAppId=
admobBannerId=
